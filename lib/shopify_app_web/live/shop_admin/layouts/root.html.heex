<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="shopify-api-key" content={ShopifyApp.Config.api_key()} />

    <%!-- Polaris CSS --%>
    <OctantisWeb.Components.Head.stylesheet />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/shop_admin.css"} />
    <%!-- AppBridge JS --%>
    <OctantisWeb.Components.Head.javascript />
    <script defer data-phx-track-static type="text/javascript" src={~p"/assets/js/shop_admin.js"}>
    </script>

    <ui-nav-menu>
      <a href="/live_shop_admin/" rel="home">Root</a>
      <a href="/live_shop_admin/">Home</a>
      <a href="/live_shop_admin/customer_rewards">Customer Rewards</a>
    </ui-nav-menu>
  </head>
  <body style="background-color: var(--p-color-bg-app); color: var(--p-color-text);">
    {@inner_content}
  </body>
</html>
